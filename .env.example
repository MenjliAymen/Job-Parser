# Copy to .env (gitignored) and adjust. Real environment variables take precedence over this file.
# All settings are optional; see Job_parser/config.py for defaults.

# --- Option A: Groq (or any OpenAI-compatible API: OpenRouter, OpenAI, ...) ---
# Free key: https://console.groq.com/keys   GET /health lists the models your key can use.
LLM_PROVIDER=openai
LLM_API_KEY=your-groq-key-here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-20b
# LLM_REASONING_MODEL=openai/gpt-oss-120b
# Answer budget per call; reasoning tokens count against it. Groq's free tier allows 8000 tokens/minute.
# LLM_MAX_TOKENS=4096
# gpt-oss reasoning depth (low|medium|high). Set empty for non-reasoning models.
# LLM_REASONING_EFFORT=low

# --- Option B: local Ollama (default when LLM_PROVIDER is unset) ---
# LLM_PROVIDER=ollama
# LLM_BASE_URL=http://127.0.0.1:11434
# LLM_MODEL=mistral
# LLM_REASONING_MODEL=deepseek-r1

# --- Option C: no model at all: run `python -m devtools.fake_llm_server` and use Option B's defaults ---

# Identical requests are answered from an in-memory cache (entries per model; 0 disables).
# LLM_CACHE_SIZE=256
# Max simultaneous requests per model; extra requests queue instead of tripping rate limits.
# LLM_MAX_CONCURRENCY=4
# LLM_TIMEOUT=300
# LLM_RETRIES=3
# LLM_RETRY_DELAY=5
# DATA_DIR=./data
# LOG_LEVEL=INFO
